# Naama Search Engine Port Configuration
# Copy this file to .env and adjust ports if needed

# Production API service port (external:internal)
PROD_PORT_EXTERNAL=7901
PROD_PORT_INTERNAL=8000

# Development API service port (external:internal)
DEV_PORT_EXTERNAL=7902
DEV_PORT_INTERNAL=8000

# UI service port (external:internal)
UI_PORT_EXTERNAL=7900
UI_PORT_INTERNAL=7905

# API URL for UI to connect to backend
# Update this to match PROD_PORT_EXTERNAL
VITE_API_URL=http://localhost:7901